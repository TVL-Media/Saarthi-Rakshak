{
  "name": "sarthi-rakshak",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter server test && pnpm --filter admin test",
    "lint": "pnpm -r lint",
    "format": "prettier --write server apps/admin packages/shared",
    "format:check": "prettier --check server apps/admin packages/shared",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:migrate:test": "pnpm --filter server db:migrate:test",
    "db:rollback": "pnpm --filter server db:rollback",
    "db:status": "pnpm --filter server db:status",
    "app:setup": "pnpm --filter server app:setup"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
