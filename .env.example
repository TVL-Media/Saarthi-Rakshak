# Copy this file to .env and adjust if needed. Never commit .env.
# Placeholder values only — safe for local development, never use them on a real server.

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL (+ PostGIS)
POSTGRES_HOST=localhost
# 5433 avoids clashing with a PostgreSQL installed directly on Windows (which uses 5432)
POSTGRES_PORT=5433
POSTGRES_USER=sarthi
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=sarthi_dev
# Separate database for automated tests (wiped after each test run).
# DATABASE_URL_TEST and REDIS_URL_TEST are required in development and test, not in production.
POSTGRES_TEST_DB=sarthi_test
DATABASE_URL=postgresql://sarthi:change_me_local_only@localhost:5433/sarthi_dev
DATABASE_URL_TEST=postgresql://sarthi:change_me_local_only@localhost:5433/sarthi_test

# Redis (/0 for development, /1 for automated tests)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1

# Admin login
# 32 random bytes in base64. Generate your own (never reuse one from another environment):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes existing 2-step setups and backup codes stop working.
ADMIN_TOTP_ENCRYPTION_KEY=generate_me
# The admin panel's address (CORS and Origin check). Vite's dev server by default.
ADMIN_PANEL_ORIGIN=http://localhost:5173

# Admin panel (apps/admin): the API address it calls. Must match where the server runs.
VITE_API_URL=http://localhost:3000

# 2-step login for admins (authenticator app): on or off.
# Default: off in development, on in test and production. The server refuses to start
# with "off" when NODE_ENV=production (staging and production always use 2-step).
# ADMIN_TWO_STEP=off
