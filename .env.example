# Copy this file to .env and adjust if needed. Never commit .env.
# Placeholder values only — safe for local development, never use them on a real server.

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL (+ PostGIS)
POSTGRES_HOST=localhost
# 5433 avoids clashing with a PostgreSQL installed directly on Windows (which uses 5432)
POSTGRES_PORT=5433
POSTGRES_USER=sarthi
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=sarthi_dev
# Separate database for automated tests (wiped after each test run).
# DATABASE_URL_TEST and REDIS_URL_TEST are required in development and test, not in production.
POSTGRES_TEST_DB=sarthi_test
DATABASE_URL=postgresql://sarthi:change_me_local_only@localhost:5433/sarthi_dev
DATABASE_URL_TEST=postgresql://sarthi:change_me_local_only@localhost:5433/sarthi_test

# Redis (/0 for development, /1 for automated tests)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_URL_TEST=redis://localhost:6379/1

# Admin login
# 32 random bytes in base64. Generate your own (never reuse one from another environment):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes existing 2-step setups and backup codes stop working.
ADMIN_TOTP_ENCRYPTION_KEY=generate_me
# The admin panel's address (CORS and Origin check). Vite's dev server by default.
ADMIN_PANEL_ORIGIN=http://localhost:5173

# Admin panel (apps/admin): the API address it calls. Must match where the server runs.
VITE_API_URL=http://localhost:3000

# 2-step login for admins (authenticator app): on or off.
# Default: off in development, on in test and production. The server refuses to start
# with "off" when NODE_ENV=production (staging and production always use 2-step).
# ADMIN_TWO_STEP=off

# File storage for photos and audio (S3 API). Locally: SeaweedFS from docker-compose.yml.
# Outside production these are the defaults, so you only need them to change something.
# Production (DigitalOcean Spaces) must set S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY and S3_SECRET_KEY.
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
# Address phones use for upload links, if different (e.g. http://<laptop-ip>:8333 over Wi-Fi).
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=sarthi-dev
# Separate bucket for automated tests (never the S3_BUCKET above).
S3_BUCKET_TEST=sarthi-test
S3_ACCESS_KEY=sarthi_local
S3_SECRET_KEY=change_me_local_only

# App login (phone OTP) with Firebase. Without FIREBASE_PROJECT_ID, app login is off locally
# (the admin panel still works). Required in production.
# FIREBASE_PROJECT_ID=sarthi-rakshak
# Path to the Firebase service-account key file. Keep it OUTSIDE the project folder; never commit it.
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\you\firebase-key.json

# Development only: test login for the app without Firebase SMS (debug app built with DEV_LOGIN=true).
# Any Indian mobile number + DEV_LOGIN_CODE works until DEV_LOGIN_UNTIL. Set DEV_LOGIN_PHONE to allow
# only that one number. The server refuses to start in production with any of these set.
# DEV_LOGIN_CODE=123456
# DEV_LOGIN_UNTIL=2026-11-30
# DEV_LOGIN_PHONE=

# Guardian invites and links. Local defaults apply outside production; both required in production.
# PHONE_HASH_KEY: 32 random bytes in base64 (generate like ADMIN_TOTP_ENCRYPTION_KEY). Changing it later
# means declined numbers could be invited again.
# PHONE_HASH_KEY=
# Where the guardian pages are served (used in invite and SOS links).
GUARDIAN_WEB_URL=http://localhost:5175
# GUARDIAN_LINK_KEY: 32 random bytes in base64 (generate like ADMIN_TOTP_ENCRYPTION_KEY). Live-link codes
# are made from it; changing it later makes links already sent stop working. Required in production.
# GUARDIAN_LINK_KEY=

# SMS. "log" prints each message in the server window instead of sending it (never in production;
# the real providers are added once the client has chosen them and DLT is approved).
SMS_MAIN_PROVIDER=log
# Backup provider: none or log.
SMS_BACKUP_PROVIDER=none
# Shared secret the SMS providers send with delivery reports (header x-webhook-secret).
# At least 24 characters. Required in production; without it delivery reports are refused.
# SMS_WEBHOOK_SECRET=

# Background worker (alerts, safety timers, cleanup) inside the server: on or off.
WORKER=on

# Guardian pages (apps/guardian-web): Google Maps browser key. Without it the page shows a
# "Open in Google Maps" link instead of the live map.
# VITE_GOOGLE_MAPS_API_KEY=

# Test server on Render only (see render.yaml): serve the built admin panel and guardian page from
# this server, and trust Render's proxy for the phone's address. Leave both out locally.
# SERVE_WEB=on
# TRUST_PROXY_HOPS=1
