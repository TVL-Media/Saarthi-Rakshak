{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "db:migrate": "nest build && node dist/database/migrate.js latest",
    "db:migrate:test": "nest build && node dist/database/migrate.js latest --test",
    "db:rollback": "nest build && node dist/database/migrate.js down",
    "db:status": "nest build && node dist/database/migrate.js status",
    "app:setup": "nest build && node dist/setup/cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "12.2.0",
    "@sarthi/shared": "workspace:*",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "ioredis": "5.11.1",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*[.]spec[.]ts$",
    "transform": {
      "^.+[.]ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testEnvironment": "node"
  }
}
