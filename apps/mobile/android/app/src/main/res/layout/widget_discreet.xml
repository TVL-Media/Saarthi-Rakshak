<?xml version="1.0" encoding="utf-8"?>
<!-- Discreet mode widget: looks like an ordinary app icon (plain tile + label), not like a
     safety app. One tap opens the quiet SOS countdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/discreet_button"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="2dp"
    android:contentDescription="Quick help">

    <ImageView
        android:id="@+id/discreet_icon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/widget_discreet_bg"
        android:padding="13dp"
        android:src="@drawable/ic_quick_help"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Quick help"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:shadowColor="#B3000000"
        android:shadowDy="1"
        android:shadowRadius="3" />
</LinearLayout>
